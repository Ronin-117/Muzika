import fetch from 'node-fetch';
import { Innertube, UniversalCache } from 'youtubei.js';

const app = express();
const PORT = process.env.PORT || 3000;

let innertube: Innertube;

async function initializeInnerTube(): Promise<void> {
  innertube = await Innertube.create({
    cache: new UniversalCache(true),
    generate_session_locally: true
  });
  console.log('[Muzika Engine] InnerTube session established successfully.');
}

initializeInnerTube().catch(console.error);

// Catalog Search Route (Enforces Pure Music Results)
app.get('/api/search', async (req: Request, res: Response): Promise<any> => {
  try {
    const query = req.query.q as string;
    if (!query) return res.status(400).json({ error: 'Search query parameter missing' });

    // Target YouTube Music Song Catalog explicitly
    const searchResults = await innertube.music.search(query, { type: 'song' });
    
    const tracks = searchResults.songs?.contents.map((song) => ({
      id: song.id,
      title: song.title,
      artist: song.artists?.map((a) => a.name).join(', ') || 'Unknown Artist',
      album: song.album?.name || 'Single',
      duration: song.duration?.seconds || 0,
      artwork: song.thumbnail?.contents[0]?.url || ''
    }));

    return res.json({ tracks: tracks || [] });
  } catch (err: any) {
    console.error('[Search Error]', err);
    return res.status(500).json({ error: err.message });
  }
});

// Stream Proxy Route (HTTP 206 Partial Content Forwarding)
app.get('/api/stream', async (req: Request, res: Response): Promise<any> => {
  try {
    const videoId = req.query.id as string;
    if (!videoId) return res.status(400).json({ error: 'Track ID parameter missing' });

    const info = await innertube.getBasicInfo(videoId, 'WEB_REMIX');
    const format = info.chooseFormat({ quality: 'best', type: 'audio' });

    if (!format) {
      return res.status(404).json({ error: 'Audio stream format unavailable' });
    }

    const rawStreamUrl = format.decipher(innertube.session.player);
    const clientRange = req.headers.range || 'bytes=0-';

    const upstreamHeaders: Record<string, string> = {
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36',
      'Range': clientRange
    };

    const upstreamResponse = await fetch(rawStreamUrl, { headers: upstreamHeaders });

    if (!upstreamResponse.ok && upstreamResponse.status !== 206) {
      return res.status(upstreamResponse.status).json({ error: 'Upstream CDN error' });
    }

    // Populate HTTP 206 Range Response Headers
    res.status(206);
    res.setHeader('Accept-Ranges', 'bytes');
    res.setHeader('Content-Type', upstreamResponse.headers.get('content-type') || 'audio/mp4');
    
    if (upstreamResponse.headers.has('content-range')) {
      res.setHeader('Content-Range', upstreamResponse.headers.get('content-range')!);
    }
    if (upstreamResponse.headers.has('content-length')) {
      res.setHeader('Content-Length', upstreamResponse.headers.get('content-length')!);
    }
    res.setHeader('Cache-Control', 'public, max-age=31536000, immutable');

    // Pipe upstream binary stream directly to express response
    upstreamResponse.body.pipe(res);
  } catch (err: any) {
    console.error('[Stream Proxy Error]', err);
    return res.status(500).json({ error: err.message });
  }
});

app.listen(PORT, () => {
  console.log(`[Muzika Gateway] Production service active on port ${PORT}`);
});
5.2 Service Worker Offline Range Handler (sw.ts)This Service Worker intercepts audio requests, serving cached tracks offline by constructing dynamic HTTP 206 responses.TypeScript/// <reference lib="webworker" />
declare const self: ServiceWorkerGlobalScope;

const MEDIA_CACHE_KEY = 'muzika-media-v1';

self.addEventListener('install', () => {
  self.skipWaiting();
});

self.addEventListener('activate', (event) => {
  event.waitUntil(self.clients.claim());
});

self.addEventListener('fetch', (event: FetchEvent) => {
  const url = new URL(event.request.url);

  if (url.pathname.startsWith('/api/stream')) {
    event.respondWith(handleAudioStreamFetch(event.request));
  }
});

async function handleAudioStreamFetch(request: Request): Promise<Response> {
  const cache = await caches.open(MEDIA_CACHE_KEY);

  // 1. Network First Strategy
  try {
    const networkResponse = await fetch(request);
    if (networkResponse.status === 200 || networkResponse.status === 206) {
      // Store full response when fetched from start
      if (!request.headers.get('Range') || request.headers.get('Range') === 'bytes=0-') {
        cache.put(request.url, networkResponse.clone());
      }
      return networkResponse;
    }
  } catch (networkError) {
    console.log('[ServiceWorker] Offline mode active. Accessing CacheStorage.');
  }

  // 2. Cache Fallback Strategy
  const cachedResponse = await cache.match(request.url);
  if (!cachedResponse) {
    return new Response('Track payload not available in cache', { status: 404 });
  }

  const blob = await cachedResponse.blob();
  const rangeHeader = request.headers.get('Range');

  // Handle standard non-ranged request
  if (!rangeHeader) {
    return new Response(blob, {
      status: 200,
      headers: {
        'Content-Type': cachedResponse.headers.get('Content-Type') || 'audio/mp4',
        'Content-Length': blob.size.toString(),
        'Accept-Ranges': 'bytes'
      }
    });
  }

  // 3. Synthesize HTTP 206 Partial Content Response
  const totalByteLength = blob.size;
  const byteRangeParts = rangeHeader.replace(/bytes=/, '').split('-');
  const startByte = parseInt(byteRangeParts[0], 10);
  const endByte = byteRangeParts[1] ? parseInt(byteRangeParts[1], 10) : totalByteLength - 1;

  const chunkLength = endByte - startByte + 1;
  const slicedBlob = blob.slice(startByte, endByte + 1);

  return new Response(slicedBlob, {
    status: 206,
    statusText: 'Partial Content',
    headers: {
      'Content-Type': cachedResponse.headers.get('Content-Type') || 'audio/mp4',
      'Content-Range': `bytes ${startByte}-${endByte}/${totalByteLength}`,
      'Content-Length': chunkLength.toString(),
      'Accept-Ranges': 'bytes',
      'Cache-Control': 'public, max-age=31536000'
    }
  });
}
5.3 React HTML5 Media Manager (AudioEngine.ts)This client media manager orchestrates the native <audio> element and binds MediaSession handlers to maintain lock screen execution.TypeScriptexport interface AudioTrack {
  id: string;
  title: string;
  artist: string;
  album: string;
  duration: number;
  artwork: string;
}

export class AudioEngine {
  private mediaElement: HTMLAudioElement;
  private activeTrack: AudioTrack | null = null;

  constructor() {
    this.mediaElement = new Audio();
    this.mediaElement.preload = 'metadata';
    this.attachEventListeners();
  }

  private attachEventListeners(): void {
    this.mediaElement.addEventListener('play', () => {
      if ('mediaSession' in navigator) {
        navigator.mediaSession.playbackState = 'playing';
      }
    });

    this.mediaElement.addEventListener('pause', () => {
      if ('mediaSession' in navigator) {
        navigator.mediaSession.playbackState = 'paused';
      }
    });

    this.mediaElement.addEventListener('timeupdate', () => {
      if ('mediaSession' in navigator && this.mediaElement.duration) {
        navigator.mediaSession.setPositionState({
          duration: this.mediaElement.duration,
          playbackRate: this.mediaElement.playbackRate,
          position: this.mediaElement.currentTime
        });
      }
    });

    this.mediaElement.addEventListener('ended', () => {
      this.handleTrackCompletion();
    });
  }

  public async playTrack(track: AudioTrack): Promise<void> {
    this.activeTrack = track;
    this.mediaElement.src = `/api/stream?id=${encodeURIComponent(track.id)}`;
    
    this.configureMediaSession(track);

    try {
      await this.mediaElement.play();
    } catch (err) {
      console.error('[AudioEngine] Playback activation failed:', err);
    }
  }

  private configureMediaSession(track: AudioTrack): void {
    if (!('mediaSession' in navigator)) return;

    navigator.mediaSession.metadata = new MediaMetadata({
      title: track.title,
      artist: track.artist,
      album: track.album,
      artwork: [
        { src: track.artwork || '/default-cover.png', sizes: '512x512', type: 'image/png' }
      ]
    });

    navigator.mediaSession.setActionHandler('play', () => this.mediaElement.play());
    navigator.mediaSession.setActionHandler('pause', () => this.mediaElement.pause());
    navigator.mediaSession.setActionHandler('seekto', (details) => {
      if (details.seekTime !== undefined) {
        this.mediaElement.currentTime = details.seekTime;
      }
    });
    navigator.mediaSession.setActionHandler('previoustrack', () => this.handlePrevious());
    navigator.mediaSession.setActionHandler('nexttrack', () => this.handleNext());
  }

  private handleTrackCompletion(): void {
    console.log('[AudioEngine] Track completed.');
  }

  private handlePrevious(): void {
    // Application state queue step logic
  }

  private handleNext(): void {
    // Application state queue step logic
  }
}
